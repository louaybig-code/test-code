{
  "expo": {
    "name": "StudioPilot",
    "slug": "studiopilot-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/studiopilot-white.png",
    "scheme": "studiopilot",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/studiopilot-white.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1117"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.studiopilote.app"
    },
    "android": {
      "package": "fr.studiopilote.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/studiopilot-white.png",
        "backgroundColor": "#0F1117"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/studiopilot-dark.png"
    },
    "plugins": [
      "expo-font",
      "expo-document-picker",
      "expo-image-picker"
    ],
    "extra": {
      "apiBaseUrl": "https://studiopilote.fr",
      "socketUrl": "https://studiopilote.fr",
      "socketPath": "/api/v1/socket.io"
    },
    "primaryColor": "#1A8C8C",
    "backgroundColor": "#0F1117"
  }
}