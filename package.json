    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "^6.0.5",
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
