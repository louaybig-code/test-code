# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Backend API Configuration
# VITE_API_BASE_URL: The backend API base URL for REST calls
VITE_API_BASE_URL="https://studiopilote.fr/api/v1"

# WebSocket Configuration (for real-time notifications and messages)
# VITE_SOCKET_URL: Base URL for Socket.IO connection
VITE_SOCKET_URL="https://studiopilote.fr"

# VITE_SOCKET_PATH: Socket.IO path on the server
VITE_SOCKET_PATH="/api/v1/socket.io"

